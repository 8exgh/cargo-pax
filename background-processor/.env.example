# NextJS API
NEXTJS_API_URL=http://localhost:3000
NEXTJS_API_KEY=<same-as-nextjs-BACKGROUND_PROCESSOR_API_KEY>

# OpenAI (devops secret OPENAI_API_KEY). gpt-5.4-mini is the default:
# capable enough to read a carrier page reliably at $0.75/$4.50 per 1M tokens.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Inbox polling. Each account's @cargopax.ca mailbox is read over IMAP with
# the credentials the app issued (fetched from /api/queries/mailboxes-to-poll).
IMAP_HOST=imap.migadu.com
IMAP_PORT=993
MAILBOX_POLL_INTERVAL_MS=60000
# Local test server with a self-signed certificate only:
#IMAP_TLS_REJECT_UNAUTHORIZED=false

# Try Bing's package-tracking answer box before the carrier page for
# UPS/FedEx/USPS/DHL (the original scraper's trick). Set false to skip.
TRACKING_USE_BING=true

# Browser. Headless by default; set PUPPETEER_HEADLESS=false to watch it
# locally. In Docker the image's Chromium is used via PUPPETEER_EXECUTABLE_PATH.
PUPPETEER_HEADLESS=true
#PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Polling
POLLING_INTERVAL_MS=5000
