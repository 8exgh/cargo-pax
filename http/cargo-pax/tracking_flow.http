### The dashboard's read: forwarding address, groups, trackers with their
### journey, delivered packages, recent forwarded emails
GET {{host}}/api/queries/account
Authorization: Bearer {{token}}

### Paste a carrier url (its host names the carrier; a refresh is requested
### right away)
POST {{host}}/api/commands/start-tracking-shipment
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "input": "https://www.ups.com/track?tracknum=1Z999AA10123456784"
}

### ...or just the tracking number: unique formats identify themselves
POST {{host}}/api/commands/start-tracking-shipment
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "input": "1Z999AA10123456784"
}

### ...and overlapping ones (12 digits is FedEx or Purolator) take a choice.
### Without "company" this answers 400 with reason "ambiguous" + candidates.
POST {{host}}/api/commands/start-tracking-shipment
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "input": "123456789012",
  "company": "purolator"
}

### Give it a description
POST {{host}}/api/commands/update-tracking-shipment-label
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "trackerId": "{{trackerId}}",
  "label": "New keyboard"
}

### Groups
POST {{host}}/api/commands/create-group
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Gifts"
}

### Put a tracker in a group (groupId null removes it)
POST {{host}}/api/commands/assign-tracker-to-group
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "trackerId": "{{trackerId}}",
  "groupId": "{{groupId}}"
}

### Refresh every undelivered tracker
POST {{host}}/api/commands/refresh-trackers
Authorization: Bearer {{token}}

### Delete a tracker
POST {{host}}/api/commands/delete-tracking-shipment
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "trackerId": "{{trackerId}}"
}
