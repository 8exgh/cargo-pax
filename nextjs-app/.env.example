# Database
DATABASE_PATH=./data/system.db
TENANT_DATABASES_PATH=./data/tenants

# JWT
JWT_SECRET=<generated-secure-secret>
JWT_EXPIRATION=7d

# API Key (REQUIRED - the app refuses processor requests without it)
BACKGROUND_PROCESSOR_API_KEY=<generated-secure-key>

# Public origin, used in emailed links (password reset)
APP_BASE_URL=http://localhost:3000

# The domain of every account's forwarding address (must be hosted on the
# Migadu account so the mailboxes can be created)
MAIL_DOMAIN=cargopax.ca

# Outbound email: Gmail SMTP with an app password (devops secrets
# GMAIL_8EXAMPLES_USER / GMAIL_8EXAMPLES_APP_PASSWORD). Owner notifications
# go to NOTIFY_EMAIL.
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=sbennett@8examples.com

# Inbox provisioning: Migadu admin API (devops secrets
# MIGADU_8EXAMPLES_ADMIN_EMAIL / MIGADU_8EXAMPLES_API_KEY). The app adds
# MAIL_DOMAIN to the Migadu account itself and reports the DNS records it
# needs; see GET /api/queries/mail-domain.
MIGADU_ADMIN_EMAIL=
MIGADU_API_KEY=

# Optional: when MAIL_DOMAIN's zone is on Cloudflare, the app publishes
# Migadu's mail records itself (Zone:Read + DNS:Edit). Leave unset when the
# zone lives elsewhere - the records are then reported for manual publishing.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Local dev without credentials: log emails and fake mailbox creation
EMAIL_TEST_MODE=1

# Hosts the background processor may load in its browser (comma separated
# suffixes). Leave unset for the known carriers (ups, fedex, usps, dhl,
# canada post, purolator, priority1); set for local fixtures in development.
#TRACKING_ALLOWED_HOSTS=

# Server
PORT=3000
LOG_LEVEL=info  # error | warn | info | debug
